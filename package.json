{
  "name": "@sanyimah/i18n-keys",
  "version": "0.1.0",
  "description": "Discovers i18next keys in React source, diffs them against your existing translation API, and registers the missing ones.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "i18n-keys": "dist/cli.js" },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "demo": "npm run build && node demo/test-api.mjs --sync",
    "demo:sync": "npm run build && cd demo && node ../dist/cli.js sync --apply --yes",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "jiti": "^2.4.2",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "vitest": "^2.1.0"
  }
}
